# Local backend development. For the single Hostinger deployment, use the root .env.example.
NODE_ENV=development
PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=shalinder
DB_USER=root
DB_PASSWORD=replace_with_local_mysql_password
DB_CONNECTION_LIMIT=5
# Generate with: openssl rand -hex 48
SESSION_SECRET=
FRONTEND_ORIGIN=http://localhost:5173
UPLOAD_DIR=/tmp/shalinder-uploads
SEED_DEFAULT_CONTENT=false
# Optional first-start administrator bootstrap; configure once, then remove these values.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_PASSWORD=
