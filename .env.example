# Single Hostinger Node.js app: Express serves the built React/Vite frontend and /api.
# Leave VITE_API_BASE empty so the browser uses same-origin /api URLs.
VITE_API_BASE=
NODE_ENV=production
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=replace_with_hostinger_database_name
DB_USER=replace_with_hostinger_database_user
DB_PASSWORD=replace_with_hostinger_database_password
DB_CONNECTION_LIMIT=5
# Set to a fresh value from: openssl rand -hex 48
SESSION_SECRET=
FRONTEND_ORIGIN=https://shailendrabhadauria.com
SEED_DEFAULT_CONTENT=false
# Optional first-start administrator bootstrap; set once, then remove these values.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_PASSWORD=
# Create this persistent folder outside public_html and hbuilds, then replace the account path.
UPLOAD_DIR=/home/replace_with_hostinger_username/storage/shalinder-uploads
